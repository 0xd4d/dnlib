<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(SolutionDir)\DnlibCommon.props" Condition="Exists('$(SolutionDir)\DnlibCommon.props')" />

  <PropertyGroup>
    <DefineConstants>$(DefineConstants);$(MoreDefineConstants)</DefineConstants>
    <DefineConstants Condition=" '$(DnlibThreadSafe)' != 'false' ">$(DefineConstants);THREAD_SAFE</DefineConstants>
    <TargetFrameworks>netstandard2.0;net35;net45;net10.0</TargetFrameworks>

    <Description>Reads and writes .NET assemblies and modules</Description>
    <Title>$(Description)</Title>
    <Copyright>Copyright (C) 2012-2026 de4dot@gmail.com</Copyright>
    <AssemblyTitle>dnlib</AssemblyTitle>
    <AssemblyTitle Condition="$(DefineConstants.Contains(THREAD_SAFE))">$(AssemblyTitle) (thread safe)</AssemblyTitle>
    <AssemblyName>dnlib</AssemblyName>
    <PackageId>dnlib</PackageId>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>4.5.0</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Authors>0xd4d</Authors>
    <PackageProjectUrl>https://github.com/0xd4d/dnlib</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageVersion>$(InformationalVersion)</PackageVersion>
    <PackageTags>dotnet;assembly;module;reader;writer;PDB;PortablePdb;WindowsPdb;IL;CIL;MSIL;metadata</PackageTags>
    <AnalysisLevel>latest</AnalysisLevel>
    <Features>strict;nullablePublicOnly</Features>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>

    <PackageDescription>
Reads and writes .NET assemblies and modules, Windows PDBs and Portable PDBs.

For better *Windows PDB* writer support, you should add a reference to `Microsoft.DiaSymReader.Native` nuget package too, see the dnlib README for more info: https://github.com/0xd4d/dnlib#windows-pdbs . You don't need to do anything special for *Portable PDB* support.
    </PackageDescription>
    <PackageReleaseNotes>https://github.com/0xd4d/dnlib/releases</PackageReleaseNotes>

    <AssemblyOriginatorKeyFile>..\dnlib.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Obsolete APIs that are still used by the public API (eg. IFormatter, serialization ctors) or to keep
       existing behavior. Removing them would be a breaking change.
       SYSLIB0011: BinaryFormatter / IFormatter
       SYSLIB0037: AssemblyName.HashAlgorithm etc
       SYSLIB0050: Formatter-based serialization
       SYSLIB0051: Exception serialization ctors -->
  <PropertyGroup Condition=" '$(TargetFramework)' != '' AND $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0')) ">
    <NoWarn>$(NoWarn);SYSLIB0011;SYSLIB0037;SYSLIB0050;SYSLIB0051</NoWarn>
    <!-- Implies IsTrimmable and enables the trim, AOT and single-file analyzers -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- Nullable annotations are emitted in all builds, but only the net10.0 build reports nullable warnings
       since the older frameworks' reference assemblies aren't annotated (eg. string.IsNullOrEmpty() has no
       [NotNullWhen]). -->
  <PropertyGroup Condition=" '$(TargetFramework)' != 'net10.0' ">
    <NoWarn>$(NoWarn);nullable</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="..\README.md" Link="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- The tests (../tests) also test internal classes. They're signed with dnlib.snk too. -->
  <PropertyGroup>
    <TestsPublicKey></TestsPublicKey>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="dnlib.Tests" Key="$(TestsPublicKey)" />
    <InternalsVisibleTo Include="dnlib.TestUtils" Key="$(TestsPublicKey)" />
  </ItemGroup>

  <!-- dnlib must not throw when reading invalid metadata, so it can't use the XxxOrThrow members or the throwing
       Import() methods. It must also work on a big endian CPU, so it can't use the methods that use the byte order of
       the CPU (BitConverter etc.). BannedSymbols.txt is generated by ../update-banned-symbols.sh: run it after adding an
       OrThrow property (CI checks it). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
  </ItemGroup>

</Project>

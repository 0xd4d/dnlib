<Project Sdk="Microsoft.NET.Sdk">

  <!-- Code that's shared by the tests: creates test assemblies (C# compiler, ilasm, patches) and checks what
       dnlib reads and writes. It doesn't reference a test framework. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <IlasmVersion>10.0.15</IlasmVersion>
    <IlasmRid Condition=" '$(IlasmRid)' == '' ">$(NETCoreSdkPortableRuntimeIdentifier)</IlasmRid>
    <IlasmExe>ilasm</IlasmExe>
    <IlasmExe Condition=" $(IlasmRid.StartsWith('win')) ">ilasm.exe</IlasmExe>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <!-- ilasm is a native program. It's only downloaded, the tests start it (see IlAssembler). -->
    <PackageDownload Include="runtime.$(IlasmRid).Microsoft.NETCore.ILAsm" Version="[$(IlasmVersion)]" />
    <AssemblyMetadata Include="IlasmPath" Value="$(NuGetPackageRoot)runtime.$(IlasmRid.ToLowerInvariant()).microsoft.netcore.ilasm/$(IlasmVersion)/runtimes/$(IlasmRid)/native/$(IlasmExe)" />
    <AssemblyMetadata Include="DnlibExpectedTfm" Value="$(DnlibExpectedTfm)" />
    <AssemblyMetadata Include="DnlibExpectedThreadSafe" Value="true" Condition=" '$(DnlibThreadSafe)' != 'false' " />
    <AssemblyMetadata Include="DnlibExpectedThreadSafe" Value="false" Condition=" '$(DnlibThreadSafe)' == 'false' " />
  </ItemGroup>

</Project>

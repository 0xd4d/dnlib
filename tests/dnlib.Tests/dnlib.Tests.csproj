<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <!-- xunit v3 tests are programs: 'dotnet test' works, and so does running the exe (also with Mono or Wine) -->
    <OutputType>Exe</OutputType>
    <RootNamespace>dnlib.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Fixtures/Sources has the source code of test assemblies. The tests compile them, they're not part of this
       assembly. -->
  <ItemGroup>
    <Compile Remove="Fixtures\Sources\**" />
    <EmbeddedResource Include="Fixtures\Sources\**" LogicalName="Fixtures/Sources/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The example programs of the repository are compiled into the tests and run by Examples/ExampleTests.cs -->
  <ItemGroup>
    <Compile Include="..\..\Examples\Example*.cs" Link="Examples\Sources\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The public API of every dnlib build as text, see Api/PublicApiTests.cs -->
  <ItemGroup>
    <EmbeddedResource Include="Api\Baselines\*.txt" LogicalName="Api/Baselines/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dnlib.TestUtils\dnlib.TestUtils.csproj" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- Writes the public API of an assembly as C# declarations -->
    <PackageReference Include="PublicApiGenerator" Version="11.5.4" />
  </ItemGroup>

</Project>

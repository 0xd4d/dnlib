<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <!-- xunit v3 tests are programs: 'dotnet test' works, and so does running the exe (also with Mono or Wine) -->
    <OutputType>Exe</OutputType>
    <RootNamespace>dnlib.Tests</RootNamespace>
  </PropertyGroup>

  <!-- Fixtures/Sources has the source code of test assemblies. The tests compile them, they're not part of this
       assembly. -->
  <ItemGroup>
    <Compile Remove="Fixtures\Sources\**" />
    <EmbeddedResource Include="Fixtures\Sources\**" LogicalName="Fixtures/Sources/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dnlib.TestUtils\dnlib.TestUtils.csproj" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
  </ItemGroup>

</Project>
